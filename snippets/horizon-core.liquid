<!-- Global Horizon Utilities -->
<script>
  (function () {
    window.Horizon = window.Horizon || {};

    // Resource Registry
    window.Horizon.resources = {
      three: 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js',
      gltfLoader: 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js',
      gsap: 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js',
      scrollTrigger: 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js',
      flickityJS: 'https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js',
      flickityCSS: 'https://unpkg.com/flickity@2/dist/flickity.min.css',
    };

    // Async Script Loader
    window.Horizon.loadScript = (url) => {
      return new Promise((resolve, reject) => {
        // Check if script is already present
        if (document.querySelector(`script[src="${url}"]`)) {
          // If it's loaded, resolve immediately.
          // Note: In a real robust system we'd check 'load' state, but for CDN links this is usually enough check for existence.
          return resolve();
        }
        const script = document.createElement('script');
        script.src = url;
        script.async = true;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    };

    // CSS Loader
    window.Horizon.loadStyle = (url) => {
      if (document.querySelector(`link[href="${url}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = url;
      document.head.appendChild(link);
    };

    // Design System Helper
    window.Horizon.design = {
      glass: 'bg-horizon-card backdrop-blur-xl border border-white/10 shadow-2xl',
      gradient: 'bg-gradient-to-tr from-horizon-bg via-slate-900 to-slate-800',
    };

    console.log('Horizon Core Initialized 🚀');
  })();
</script>
