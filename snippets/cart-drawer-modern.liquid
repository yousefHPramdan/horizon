{% comment %}
  Renders cart drawer
  Usage:
  {% render 'cart-drawer-modern' %}
{% endcomment %}

<!-- Dawn Dependencies -->
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer fixed inset-0 z-50 transform transition-transform duration-300 translate-x-full">
  <div id="CartDrawer" class="cart-drawer h-full w-full pointer-events-none">
    <!-- Overlay -->
    <div
      id="CartDrawer-Overlay"
      class="fixed inset-0 bg-black/50 transition-opacity opacity-0 cursor-pointer pointer-events-auto"
      onclick="this.closest('cart-drawer').close()"
    ></div>

    <!-- Drawer Content -->
    <div
      class="drawer__inner h-full w-full md:w-[400px] ml-auto bg-white flex flex-col shadow-xl transform transition-transform pointer-events-auto"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <!-- Empty State -->
      {%- if cart == empty -%}
        <div class="flex flex-col items-center justify-center h-full p-8 text-center space-y-6">
          <h2 class="text-2xl font-bold">{{ 'sections.cart.empty' | t }}</h2>
          <button
            class="absolute top-4 right-4 p-2 hover:bg-gray-100 rounded-full"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close', class: 'w-6 h-6' %}
          </button>
          <a
            href="{{ routes.all_products_collection_url }}"
            class="bg-black text-white px-8 py-3 rounded-full hover:bg-gray-800 transition"
          >
            {{ 'general.continue_shopping' | t }}
          </a>
        </div>
      {%- endif -%}

      <!-- Header -->
      <div class="drawer__header flex items-center justify-between p-4 border-b">
        <h2 class="text-xl font-bold">{{ 'sections.cart.title' | t }}</h2>
        <button
          class="p-2 hover:bg-gray-100 rounded-full"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>

      <cart-drawer-items class="flex-1 overflow-y-auto p-4 {% if cart == empty %}hidden{% endif %}">
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="block h-full"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="space-y-6">
            {%- if cart != empty -%}
              {%- for item in cart.items -%}
                <div id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="flex gap-4">
                  <!-- Image -->
                  <div class="relative w-24 aspect-[4/5] flex-shrink-0 bg-gray-100 rounded-md overflow-hidden">
                    {% if item.image %}
                      <img
                        class="w-full h-full object-cover"
                        src="{{ item.image | image_url: width: 300 }}"
                        alt="{{ item.image.alt | escape }}"
                        loading="lazy"
                        width="150"
                        height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                      >
                    {% endif %}
                  </div>

                  <!-- Details -->
                  <div class="flex-1 flex flex-col justify-between">
                    <div>
                      <h3 class="font-medium text-gray-900">
                        <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                      </h3>
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="text-sm text-gray-500 mt-1">
                          {%- for option in item.options_with_values -%}
                            {{ option.value -}}
                            {%- unless forloop.last %} / {% endunless %}
                          {%- endfor -%}
                        </p>
                      {%- endunless -%}
                      <div class="text-sm font-medium text-gray-900 mt-2">
                        {{ item.final_line_price | money }}
                      </div>
                    </div>

                    <!-- Quantity & Remove -->
                    <div class="flex items-center justify-between mt-4">
                      <quantity-popover class="flex items-center border rounded-full">
                        <button
                          name="minus"
                          type="button"
                          class="w-8 h-8 flex items-center justify-center hover:bg-gray-100 rounded-l-full"
                        >
                          -
                        </button>
                        <input
                          class="w-8 text-center text-sm border-none focus:ring-0 p-0"
                          type="number"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                          min="0"
                          id="Drawer-quantity-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                        >
                        <button
                          name="plus"
                          type="button"
                          class="w-8 h-8 flex items-center justify-center hover:bg-gray-100 rounded-r-full"
                        >
                          +
                        </button>
                      </quantity-popover>

                      <cart-remove-button
                        id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                        data-index="{{ item.index | plus: 1 }}"
                      >
                        <button type="button" class="text-sm text-red-500 underline hover:no-underline">
                          {{ 'sections.cart.remove_title' | t: title: item.title }}
                        </button>
                      </cart-remove-button>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </form>
      </cart-drawer-items>

      <!-- Footer -->
      <div class="border-t p-4 bg-gray-50">
        <div class="flex items-center justify-between mb-4">
          <span class="text-lg font-bold">{{ 'sections.cart.estimated_total' | t }}</span>
          <span class="text-lg font-bold">{{ cart.total_price | money_with_currency }}</span>
        </div>

        <button
          type="submit"
          id="CartDrawer-Checkout"
          class="w-full bg-black text-white py-3 rounded-md font-bold hover:bg-gray-800 transition"
          name="checkout"
          form="CartDrawer-Form"
          {% if cart == empty %}
            disabled
          {% endif %}
        >
          {{ 'sections.cart.checkout' | t }}
        </button>
      </div>
    </div>
  </div>
</cart-drawer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function toggleDrawer() {
      const drawer = document.querySelector('cart-drawer');
      if (drawer) {
        if (drawer.classList.contains('active')) drawer.close();
        else drawer.open();
      }
    }
  });
</script>
