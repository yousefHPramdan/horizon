{% schema %}
{
  "name": "3D Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Future of eCommerce"
    }
  ],
  "presets": [
    {
      "name": "3D Hero (Three.js)"
    }
  ]
}
{% endschema %}

<div class="relative w-full h-[600px] bg-black text-white overflow-hidden">
  <!-- 3D Background -->
  <hero-3d class="absolute inset-0 z-0 block w-full h-full"></hero-3d>

  <!-- Overlay Content -->
  <div class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none">
    <scroll-reveal data-animation="fade-up">
      <h1 class="text-6xl font-black uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-600">
        {{ section.settings.heading }}
      </h1>
    </scroll-reveal>
  </div>
</div>
