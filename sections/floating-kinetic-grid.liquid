{% schema %}
{
  "name": "Floating Kinetic Grid",
  "settings": [
    {
      "type": "header",
      "content": "Data Source"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select the collection to display."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 6,
      "max": 12,
      "step": 3,
      "label": "Product Limit",
      "default": 9
    },
    {
      "type": "header",
      "content": "Visuals"
    },
    {
      "type": "range",
      "id": "parallax_intensity",
      "min": 0,
      "max": 100,
      "step": 10,
      "label": "Parallax Intensity",
      "default": 50,
      "info": "Controls the vertical float speed."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Price Accent Color",
      "default": "#3b82f6"
    }
  ],
  "presets": [
    {
      "name": "Floating Kinetic Grid"
    }
  ]
}
{% endschema %}

<div
  id="section-{{ section.id }}"
  class="floating-grid-section relative w-full py-24 overflow-hidden"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
>
  <div class="max-w-[1400px] mx-auto px-4 md:px-8">
    {% if section.settings.collection != blank %}
      <!-- Asymmetrical Grid: 2 cols mobile, 3 cols desktop -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-x-4 gap-y-12 md:gap-x-8 md:gap-y-24">
        {% for product in section.settings.collection.products limit: section.settings.limit %}
          {% comment %}
            Calculate stagger/offset based on index to create "random" floating feel.
            Desktop: Top offset 0, 4rem, 8rem cyclically.
            Parallax Speed: Varied by column.
          {% endcomment %}

          {% capture desktop_offset_class %}
            {% cycle 'md:mt-0', 'md:mt-16', 'md:mt-32' %}
          {% endcapture %}

          {% capture parallax_speed %}
            {% cycle 20, 50, 80 %}
          {% endcapture %}

          <div
            class="product-card group relative {{ desktop_offset_class }} opacity-0 translate-y-12"
            data-speed="{{ parallax_speed | times: section.settings.parallax_intensity | divided_by: 50.0 }}"
          >
            <a href="{{ product.url }}" class="block w-full">
              <!-- Image Container -->
              <div class="relative w-full aspect-[3/4] overflow-hidden bg-gray-100 mb-6">
                <!-- Grayscale to Color Transition -->
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.title }}"
                    class="w-full h-full object-cover grayscale transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-105"
                    loading="lazy"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'w-full h-full text-gray-300' }}
                {% endif %}

                <!-- Overlay (Optional for extra depth) -->
                <div
                  class="absolute inset-0 bg-transparent group-hover:bg-white/5 transition-colors duration-300"
                ></div>
              </div>

              <!-- Typography -->
              <div class="flex flex-col items-start space-y-2">
                <h3
                  class="text-lg md:text-xl font-bold uppercase tracking-tighter leading-none"
                  style="color: {{ section.settings.text_color }}"
                >
                  {{ product.title }}
                </h3>
                <span
                  class="text-sm font-medium opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
                  style="color: {{ section.settings.accent_color }}"
                >
                  {{ product.price | money }}
                </span>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="text-center py-20 opacity-50">
        <p>Please select a collection to display the Floating Kinetic Grid.</p>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const sectionEl = document.getElementById(`section-${sectionId}`);

    // Use Horizon Core Architecture
    const ensureHorizon = (cb) => {
      if (window.Horizon) cb();
      else
        document.addEventListener('DOMContentLoaded', () => {
          if (window.Horizon) cb();
        });
    };

    ensureHorizon(async () => {
      const H = window.Horizon;

      // Load Dependencies
      await H.loadScript(H.resources.gsap).then(() => H.loadScript(H.resources.scrollTrigger));

      gsap.registerPlugin(ScrollTrigger);

      const cards = sectionEl.querySelectorAll('.product-card');

      // 1. Entrance Animation (Staggered Fade In)
      ScrollTrigger.batch(cards, {
        start: 'top 90%',
        onEnter: (batch) => {
          gsap.to(batch, {
            opacity: 1,
            y: 0,
            duration: 1,
            stagger: 0.15,
            ease: 'power3.out',
          });
        },
        once: true,
      });

      // 2. Parallax Floating Effect
      // We want the cards to move different speeds relative to scroll
      cards.forEach((card) => {
        const speed = parseFloat(card.dataset.speed || 30);

        gsap.to(card, {
          y: `-${speed}px`, // Move UP slightly faster/slower than scroll
          ease: 'none',
          scrollTrigger: {
            trigger: sectionEl,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1,
          },
        });
      });
    });
  })();
</script>
