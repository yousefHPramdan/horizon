{% schema %}
{
  "name": "Featured Collection (MOD)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection (Modern)"
    }
  ]
}
{% endschema %}

<section class="py-12 bg-gray-50">
  <div class="container mx-auto px-4">
    <scroll-reveal data-animation="fade-up">
      <h2 class="text-3xl font-bold mb-8 text-center">{{ section.settings.title }}</h2>
    </scroll-reveal>

    <slider-component data-options='{"cellAlign": "left", "contain": true, "pageDots": false}'>
      <div class="carousel w-full" data-slider-container>
        {%- if section.settings.collection != blank -%}
          {%- for product in section.settings.collection.products limit: 6 -%}
            <div class="carousel-cell w-full md:w-1/3 lg:w-1/4 px-2">
              <scroll-reveal data-animation="scale-up">
                <div class="bg-white rounded shadow hover:shadow-lg transition p-4">
                  <div class="aspect-square bg-gray-200 mb-4 overflow-hidden rounded">
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.title }}"
                      class="w-full h-full object-cover hover:scale-110 transition-transform duration-500"
                      loading="lazy"
                    >
                  </div>
                  <h3 class="font-bold text-lg mb-1">{{ product.title }}</h3>
                  <p class="text-gray-600">{{ product.price | money }}</p>
                </div>
              </scroll-reveal>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Placeholder Content -->
          {%- for i in (1..4) -%}
            <div class="carousel-cell w-full md:w-1/3 lg:w-1/4 px-2">
              <div class="bg-white rounded shadow p-4 h-64 flex items-center justify-center">
                <p>Product {{ i }}</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </slider-component>
  </div>
</section>
